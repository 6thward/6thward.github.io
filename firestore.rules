rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // Who is who
    // ---------------------------------------------------------------------
    // Two kinds of people sign in:
    //   * Google accounts (bishopric, clerks, members) — users/{uid}.role is
    //     pending -> member -> bishopric -> bishop, exactly as before.
    //   * PIN people — a hidden email/password account the bishop creates
    //     from the People tab (email = pin-XXXXXX@sixthward.pin, password =
    //     the PIN). Their users/{uid} doc has role 'pin' plus a perms map:
    //       perms: { sacrament: 'edit', calendar: 'view', tasks: '', ... }
    //     Each area is '' (hidden), 'view' or 'edit'. Nothing is granted
    //     that isn't in that map.
    // The bishop's own email is recognised directly so the app can never
    // lock itself out.
    // =====================================================================
    function signedIn() {
      return request.auth != null;
    }
    function isBishopEmail() {
      return signedIn() && request.auth.token.email == 'jordanchri@gmail.com';
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function role() {
      return profile().role;
    }
    function isBishop() {
      return isBishopEmail() || (hasProfile() && role() == 'bishop');
    }
    function isBishopric() {
      return isBishop() || (hasProfile() && role() == 'bishopric');
    }
    function isMember() {
      return hasProfile() && role() == 'member';
    }
    function isPin() {
      return hasProfile() && role() == 'pin';
    }
    // Users-tab people (2026-09-19): Google sign-ins invited by email get
    // role 'user' + a perms map, exactly like PIN people.
    function isUser() {
      return hasProfile() && role() == 'user';
    }
    function revoked() {
      return hasProfile() && ('revoked' in profile()) && profile().revoked == true;
    }
    function hasPerms() {
      return (isPin() || isUser()) && !revoked() && ('perms' in profile());
    }
    function rawLevel(area) {
      return hasPerms() && (area in profile().perms) ? profile().perms[area] : '';
    }
    // per-page level ('' | 'view' | 'edit'); newer pages fall back to the
    // older, coarser key they were split from (homesac<-sacrament,
    // council<-board, users<-people) so existing grants keep working
    function pinLevel(area) {
      return area == 'homesac' && !(hasPerms() && ('homesac' in profile().perms)) ? rawLevel('sacrament')
        : area == 'council' && !(hasPerms() && ('council' in profile().perms)) ? rawLevel('board')
        : area == 'users' && !(hasPerms() && ('users' in profile().perms)) ? rawLevel('people')
        : rawLevel(area);
    }
    // Members (Google role) see the three everyday areas, nothing sensitive.
    function memberSees(area) {
      return isMember() && (area == 'sacrament' || area == 'calendar' || area == 'tasks');
    }
    function canView(area) {
      return isBishopric() || memberSees(area)
        || pinLevel(area) == 'view' || pinLevel(area) == 'edit';
    }
    function canEdit(area) {
      return isBishopric() || pinLevel(area) == 'edit';
    }
    // anyone who has been let in at all (for name pickers / rosters)
    function hasAccess() {
      return isBishopric() || isMember() || ((isPin() || isUser()) && !revoked());
    }
    // may manage other users (Users tab) — the bishop, or anyone given that page
    function manages() {
      return isBishop() || pinLevel('users') == 'edit';
    }

    // ---- Profiles / roles / permissions ----
    function inviteFor(email) {
      return get(/databases/$(database)/documents/invites/$(email)).data;
    }
    function claimsInvite() {
      // first Google sign-in of an invited address: the profile must carry
      // exactly the access the inviter chose
      return signedIn() && request.auth.token.email != null
        && exists(/databases/$(database)/documents/invites/$(request.auth.token.email.lower()))
        && request.resource.data.role == 'user'
        && request.resource.data.perms == inviteFor(request.auth.token.email.lower()).perms;
    }
    match /users/{uid} {
      // your own profile (to learn your role + perms); the roster for anyone let in
      allow read: if signedIn() && (request.auth.uid == uid || hasAccess());
      // a new Google sign-in may only create their own profile, as 'pending'
      // (or by claiming an invite; the bishop's email may bootstrap itself as
      // bishop); whoever manages users creates PIN people's profiles
      allow create: if manages() || (signedIn() && request.auth.uid == uid && (
        request.resource.data.role == 'pending' ||
        claimsInvite() ||
        (request.resource.data.role == 'bishop' && isBishopEmail())
      ));
      // managers assign access; anyone may stamp their own last-used time
      allow update: if manages()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen']));
      allow delete: if manages();
    }

    // ---- Invitations by email (Users tab); the invitee may read + clear their own ----
    match /invites/{email} {
      allow read: if manages() || (signedIn() && request.auth.token.email != null && request.auth.token.email.lower() == email);
      allow create, update: if manages();
      allow delete: if manages() || (signedIn() && request.auth.token.email != null && request.auth.token.email.lower() == email);
    }

    // ---- PINs (plain, so a manager can look one up and re-tell it) ----
    match /pins/{uid} {
      allow read, write: if manages();
    }

    // ---- Tasks ----
    match /tasks/{id} {
      allow read: if canView('tasks');
      allow create, delete: if canEdit('tasks');
      // anyone who can see tasks may update one assigned to them (e.g. mark done)
      allow update: if canEdit('tasks')
        || (canView('tasks') && resource.data.assigneeUid == request.auth.uid);
    }

    // ---- Sacrament meeting plans ----
    // Home Sacrament people may read plans and change only the attendance fields
    match /meetings/{id} {
      allow read: if canView('sacrament') || canView('homesac');
      allow write: if canEdit('sacrament');
      allow create: if canEdit('homesac')
        && request.resource.data.keys().hasOnly(['date', 'hbSkip', 'hbOn', 'updatedAt']);
      allow update: if canEdit('homesac')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hbSkip', 'hbOn', 'updatedAt']);
    }

    // ---- Calendar events ----
    match /events/{id} {
      allow read, create: if canView('calendar');
      allow update, delete: if canEdit('calendar')
        || (canView('calendar') && resource.data.createdBy == request.auth.uid);
    }

    // ---- Published programs (2026-09-20): one Sunday's program-only snapshot
    // under a random token; anyone holding the link may read that one doc.
    // Listing is closed, so tokens can't be enumerated.
    match /public/{token} {
      allow get: if true;
      allow list: if false;
      allow write: if canEdit('sacrament');
    }

    // ---- Shared settings (rosters, hymns, homebound list, program) ----
    match /settings/{id} {
      allow read: if hasAccess();
      allow write: if canEdit('sacrament') || (id == 'homebound' && canEdit('homesac'));
    }

    // ---- Member Board (cards per person in custom sections) ----
    match /board/{id} {
      allow read: if canView('board');
      allow write: if canEdit('board');
    }
    match /boardColumns/{id} {
      allow read: if canView('board');
      allow write: if canEdit('board');
    }
    match /councils/{id} {
      allow read: if canView('council');
      allow write: if canEdit('council');
    }

    // ---- Callings pipeline (sensitive) ----
    match /callings/{id} {
      allow read: if canView('callings');
      allow write: if canEdit('callings');
    }
    match /callingGroups/{id} {
      allow read: if canView('callings');
      allow write: if canEdit('callings');
    }

    // ---- Confidential (bishop, or a PIN the bishop explicitly grants) ----
    match /confidential/{id} {
      allow read: if isBishop() || pinLevel('confidential') == 'view' || pinLevel('confidential') == 'edit';
      allow write: if isBishop() || pinLevel('confidential') == 'edit';
    }

    // everything else: denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
